# Copy to .env and fill in what you need. Everything is optional except FFmpeg on your PATH.

# Where the app is reachable in your browser. OAuth redirect URIs are {CLIPFORGE_BASE_URL}/oauth/<platform>/callback
CLIPFORGE_BASE_URL=http://localhost:8000
CLIPFORGE_PORT=8000
# CLIPFORGE_DATA_DIR=data

# --- Clip shape ---
CLIP_MIN_SECONDS=15
CLIP_TARGET_SECONDS=20
CLIP_MAX_SECONDS=45
# 0 = as many good clips as the video supports
CLIP_MAX_COUNT=0
BURN_CAPTIONS=1

# --- Transcription (faster-whisper, local) ---
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- Claude picks the clips and writes the captions (optional) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- YouTube Shorts: Google Cloud console > OAuth client (Web application) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# --- TikTok: developers.tiktok.com app with Login Kit + Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY until TikTok audits your app, then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# --- Instagram Reels: Meta app with "Instagram API with Instagram Login" ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# resumable (upload from this machine) | url (Instagram fetches from CLIPFORGE_PUBLIC_URL)
INSTAGRAM_UPLOAD_MODE=resumable
# CLIPFORGE_PUBLIC_URL=https://your-tunnel.example.com

# --- X: developer.x.com project app, OAuth 2.0, type "Web App" (paid API tier needed for media) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
